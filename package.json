{
  "name": "concloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @concloud/web",
    "build": "npm run db:generate && npm run build -w @concloud/web",
    "start": "npm run start -w @concloud/web",
    "worker": "tsx --env-file=.env apps/worker/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env packages/database/seed.ts",
    "bootstrap": "tsx --env-file=.env scripts/bootstrap.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "local:db": "tsx scripts/local-db.ts",
    "local:roles": "tsx --env-file=.env scripts/local-roles.ts",
    "storage:setup": "tsx --env-file=.env scripts/storage-setup.ts",
    "jobs:retry": "tsx --env-file=.env scripts/retry-job.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "local:configure": "tsx scripts/local-configure.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "bullmq": "6.3.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.5",
    "ioredis": "6.0.0",
    "jszip": "3.10.2",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "ofx-js": "1.1.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true
  }
}
