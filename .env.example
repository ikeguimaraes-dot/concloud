# Runtime must be concloud_runtime (NOBYPASSRLS), never postgres/service_role.
DATABASE_URL=postgresql://concloud_runtime:local_dev_only@localhost:54322/postgres?schema=concloud
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=concloud-private
REDIS_URL=redis://localhost:6387
APP_URL=http://localhost:3100
REQUIRE_STAFF_MFA=true
# Only synthetic isolated local installations; NEVER production.
DEMO_MODE=false
DISPATCHER_DATABASE_URL=postgresql://concloud_dispatcher:local_dispatcher_only@localhost:54322/postgres
WORKER_PORT=3001
